# Copia este archivo a .env.local (ignorado por git) y ajusta la URL.
# Expo solo expone al código las variables con prefijo EXPO_PUBLIC_;
# reinicia `npx expo start` después de cambiarlas.

# Base de la API del backend, incluyendo /api/v1.
#   Web / simulador iOS: http://localhost:8080/api/v1
#   Emulador Android:    http://10.0.2.2:8080/api/v1
#   Dispositivo físico:  http://<IP-LAN-del-equipo>:8080/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Opcional — SonarQube local (scripts/sonarqube/setup-sonarqube.sh y `npm run sonar`).
# Nunca pongas valores reales en este archivo; usa .env.local. Ver docs/CI-CD.md.
# SONAR_HOST_URL=http://localhost:9000
# SONAR_TOKEN=
# SONAR_ADMIN_PASSWORD=
